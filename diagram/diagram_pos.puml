@startuml
title Сражение с боссом
autonumber

actor "Бегун" as User
participant "Мобильное\nприложение" as App
participant "GPS-сервис" as GPS
participant "Сервер\n(игровая логика)" as Server
database "База данных" as DB

== Начало боя ==
User -> App : Выбрать босса и начать бой
App -> Server : Запросить данные босса и персонажа
Server -> DB : Получить параметры босса и персонажа
DB --> Server : Данные
Server --> App : HP босса, характеристики персонажа
App -> GPS : Запустить отслеживание маршрута
App --> User : Бой начался

== Пробежка ==
loop пока HP босса > 0 и бегун не завершил пробежку
    GPS --> App : Координаты
    App -> App : Рассчитать дистанцию и темп\n(скользящее окно 30-60 с)
    App -> Server : Отправить дистанцию и темп
    Server -> Server : Проверить допустимость темпа\n(отсечь нереалистичные значения)
    Server -> Server : Рассчитать урон =\nдистанция × базовый урон × множитель темпа
    Server -> Server : Уменьшить HP босса
    Server --> App : Текущее HP босса
    App --> User : Обновить полоску HP босса
end

== Завершение ==
alt HP босса = 0 (победа)
    Server -> Server : Начислить опыт и выбрать награду
    Server -> DB : Сохранить победу, опыт, награду
    opt Опыта достаточно для нового уровня
        Server -> Server : Повысить уровень, начислить очки прокачки
        Server -> DB : Сохранить новый уровень
    end
    Server --> App : Победа, опыт, награда
    App --> User : Экран победы
else Бегун завершил пробежку раньше
    Server -> Server : Начислить опыт только за дистанцию
    Server -> DB : Сохранить результат пробежки
    opt Опыта достаточно для нового уровня
        Server -> Server : Повысить уровень, начислить очки прокачки
        Server -> DB : Сохранить новый уровень
    end
    Server --> App : Босс не побеждён, опыт
    App --> User : Итоговый экран
end

App -> GPS : Остановить отслеживание
@enduml