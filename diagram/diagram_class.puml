@startuml
title Диаграмма классов: беговое RPG-приложение
skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Пользователь {
  - id: int
  - email: string
  - хэшПароля: string
  + зарегистрироваться()
  + войти()
}

class Бегун {
  - имя: string
  - датаРегистрации: date
  + начатьПробежку()
  + начатьБой(босс: Босс)
  + просмотретьСтатистику()
}

class Администратор {
  + управлятьБоссами()
  + управлятьКвестами()
  + настроитьБаланс()
}

class Персонаж {
  - имя: string
  - уровень: int
  - опыт: int
  - очкиПрокачки: int
  + получитьОпыт(количество: int)
  + повыситьУровень()
  + прокачатьХарактеристику(тип: ТипХарактеристики)
}

class Характеристика {
  - тип: ТипХарактеристики
  - значение: int
}

enum ТипХарактеристики {
  СИЛА
  СКОРОСТЬ
  ВЫНОСЛИВОСТЬ
}

class Предмет {
  - название: string
  - тип: string
  - бонус: int
}

class Пробежка {
  - начало: datetime
  - конец: datetime
  - дистанцияКм: float
  - среднийТемп: float
  - статус: СтатусПробежки
  + начать()
  + завершить()
}

class ТочкаМаршрута {
  - широта: float
  - долгота: float
  - время: datetime
}

class БойСБоссом {
  - оставшеесяHP: int
  - нанесённыйУрон: int
  - статус: СтатусБоя
  + применитьУрон(урон: int)
  + проверитьПобеду(): boolean
}

enum СтатусБоя {
  АКТИВЕН
  ПАУЗА
  ПОБЕДА
  ПРЕРВАН
}

class Босс {
  - название: string
  - уровень: int
  - максимальноеHP: int
  - базовыйУрон: float
}

class Квест {
  - описание: string
  - тип: string
  - целевоеЗначение: float
  - дата: date
}

class ПрогрессКвеста {
  - текущееЗначение: float
  - выполнен: boolean
  + обновитьПрогресс(значение: float)
}

class Награда {
  - опыт: int
}

class Достижение {
  - название: string
  - условие: string
}

class КалькуляторУрона <<service>> {
  + рассчитатьУрон(дистанция: float, темп: float): int
  + рассчитатьОпыт(дистанция: float): int
  + темпДопустим(темп: float): boolean
}

class НастройкиБаланса {
  - множителиТемпа: map
  - минДопустимыйТемп: float
  - формулаОпыта: string
  - порогиУровней: list
}

Пользователь <|-- Бегун
Пользователь <|-- Администратор

Бегун "1" -- "1" Персонаж
Персонаж "1" *-- "3" Характеристика
Персонаж "1" o-- "0..*" Предмет : инвентарь

Бегун "1" -- "0..*" Пробежка
Пробежка "1" *-- "0..*" ТочкаМаршрута
Пробежка "1" -- "0..1" БойСБоссом
БойСБоссом "0..*" -- "1" Босс
БойСБоссом ..> КалькуляторУрона : использует

Босс "1" -- "1" Награда
Квест "1" -- "1" Награда
Награда "1" --> "0..1" Предмет

Бегун "1" -- "0..*" ПрогрессКвеста
ПрогрессКвеста "0..*" -- "1" Квест

Бегун "0..*" -- "0..*" Достижение : получает

КалькуляторУрона ..> НастройкиБаланса : читает

Администратор ..> Босс : управляет
Администратор ..> Квест : управляет
Администратор ..> НастройкиБаланса : настраивает
@enduml